#!/bin/sh
# Refuses commits that add credentials -- this repository is public. See .githooks/check_secrets.py
# and the Secrets section of CLAUDE.md. Enable once per clone:  git config core.hooksPath .githooks
for py in python3 python; do
  # "runs", not just "exists": Windows has a python3 stub that only opens the Store
  if "$py" -c "import sys" >/dev/null 2>&1; then
    exec "$py" "$(git rev-parse --show-toplevel)/.githooks/check_secrets.py"
  fi
done
echo "pre-commit: no python found, so the secret check could not run -- commit refused." >&2
exit 1
