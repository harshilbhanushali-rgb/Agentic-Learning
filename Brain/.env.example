GEMMA_API_KEY=your_google_ai_studio_key_here
DATABASE_URL=postgresql://user:pass@host:5432/narens_brain
JOVEO_SPEAKER_NAMES=Naren Shankar,Collin Osburn,Doug Shonrock
NAREN_SPEAKER_NAME=Naren Shankar
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=narens-brain

# --- Ego Trap (all optional — defaults shown, only set to override) ---
# "gemma" (Option A) or "similarity" (Option B) — see Ego_trap.md Step 0
STEP_0_MODE=gemma
# Write raw per-call gap JSON to gap_events in addition to the aggregate tables
ENABLE_GAP_EVENTS=true
# Option B (similarity mode) cosine-similarity cutoff for a signal match
EGO_TRAP_SIMILARITY_THRESHOLD=0.75
