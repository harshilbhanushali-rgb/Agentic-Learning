GEMMA_API_KEY=your_google_ai_studio_key_here
DATABASE_URL=postgresql://user:pass@host:5432/narens_brain
JOVEO_SPEAKER_NAMES=Naren Shankar,Collin Osburn,Doug Shonrock
NAREN_SPEAKER_NAME=Naren Shankar
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=narens-brain

# --- Gemma model/key fallback (optional) ---
# Second Google AI Studio key call_gemma rotates to once the model chain
# (gemma-4-31b-it -> gemini-3.1-flash-lite -> gemini-3.5-flash-lite) is
# exhausted on GEMMA_API_KEY. Leave unset to disable key rotation.
GEMMA_API_KEY_2=
# Master switch for the model/key fallback chain in shared/gemma.py.
# Set to false to restore the old single-model, single-key behavior.
MODEL_FALLBACK_ENABLED=true

# --- Ego Trap / Layer D ---
# Nothing to set here. Every Layer D knob lives in Brain/tuning.yaml under `layer_d:`
# alongside layers A-C, where it is validated on load (an unknown or missing key
# raises rather than silently reverting to a default).
#
# STEP_0_MODE, ENABLE_GAP_EVENTS and EGO_TRAP_SIMILARITY_THRESHOLD used to be read
# here. They are retired: ops/run_ego_trap.py exits with an error if any is still set,
# because a stale line in .env that no longer does anything is worse than either
# state -- it reads as authoritative while being ignored.
