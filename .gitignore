# --- Secrets & environments ---
.env
.venv

# --- Python build/cache artifacts ---
__pycache__
*.pyc
.pytest_cache
*.egg-info

# --- Node ---
node_modules
.next
# Written by `npm run build` (the type-check gate), rebuilt on every run.
tsconfig.tsbuildinfo

# --- Browser-check scratch output ---
# Playwright MCP writes snapshots, screenshots and console logs here during a UI
# verification pass. Evidence for one check, not source.
.playwright-mcp

# --- Transcript corpora (large, not source; supplied per-machine) ---
recordings
csm_recordings
Brain/recordings_subset*/
Brain/recordings_pull_4yr/
Brain/recordings_pull_keep/
Brain/recordings_excluded_interviews/

# --- Rebuildable local caches (hundreds of MB) ---
embed_cache.db
# The Gemini/gateway equivalent of embed_cache.db. Rebuildable, but NOT cheaply: it holds
# ~24k paid gateway embedding requests keyed on the NATIVE 3072 width, and deleting it
# re-pays all of them. Keep it on disk, out of git.
gemini_embed_cache.db
checkpoints.db

# --- Run output ---
# NOTE: gitignore does NOT apply to already-tracked files. If a log or
# artifact below ever shows up in `git status` as tracked, it was committed
# before this rule existed -- fix it with `git rm --cached <file>`, not by
# editing this file.
*.log
Brain/logs/

# Derived analysis artifacts in Brain/artifacts/, regenerated by their own script's
# non---load run. Ignore the directory, then re-admit the one file that is a real
# INPUT rather than output: calibration/graduate_sink_topics.py and
# calibration/replay_layer_c_admitted.py both read sink_pool_clusters.json.
Brain/artifacts/*
!Brain/artifacts/sink_pool_clusters.json
# The say arm's SAY/DO routing map is a hash-pinned INPUT, not a derived output:
# layer_d/move_classes.py refuses to run without it (fail-closed), and the two raw
# blind reads are its provenance. Re-admitted so a fresh clone can run the arm.
!Brain/artifacts/layer_d_move_classes.json
!Brain/artifacts/ld_moveclass_read1.txt
!Brain/artifacts/ld_moveclass_read2.txt
# Blind reads behind the repertoire pass's gates (G-R1, G-R2; findings §11b) and the
# W0 probe artifact -- the provenance of committed gate results, not regenerable
# (a re-read is a different read).
!Brain/artifacts/layer_d_oa_say_reader1.json
!Brain/artifacts/layer_d_oa_say_reader2.json
!Brain/artifacts/layer_d_oa_say_model_verdicts.json
!Brain/artifacts/layer_d_never_cells_key.json
!Brain/artifacts/layer_d_never_cells_read1.json
!Brain/artifacts/layer_d_w0_warrant_probe.json

# --- Local agent tooling scratch state ---
# Personal CLAUDE.md companion: machine-specific tooling quirks, never team-shared.
.claude.local.md
.superpowers/
.impeccable/critique/
.impeccable/live/
